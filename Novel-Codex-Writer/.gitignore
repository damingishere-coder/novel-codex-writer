# Python generated caches
**/__pycache__/
*.py[cod]

# User-created novel library data
# Keep personal manuscripts, project indexes, and deleted files out of Git.
小说项目/projects.json
小说项目/作品/*
!小说项目/作品/.gitkeep
小说项目/.trash/*
!小说项目/.trash/.gitkeep

# Recoverable and short-lived workflow state
**/记忆库/.transactions/

# Rebuildable or per-chapter generated projections
**/记忆库/index/memory_index.json
**/记忆库/current/本章写作任务书.md

# 本地密钥与环境配置（示例文件除外）
.env
.env.*
!.env.example

# 仅限本机的网页设置
frontend/.local/
