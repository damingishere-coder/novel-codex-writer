# Local temporary files
tmp/

# Secrets and machine-specific environment files
**/.env
**/.env.*
!**/.env.example

# User-created novel library data
# Keep personal manuscripts, project indexes, and deleted files out of the public repository.
小说项目/projects.json
小说项目/作品/*
!小说项目/作品/.gitkeep
小说项目/.trash/*
!小说项目/.trash/.gitkeep

# Dependencies, caches, and build output
**/node_modules/
**/dist/
**/__pycache__/
**/.sessions/
*.py[cod]
*.log

# Operating-system metadata
.DS_Store
Thumbs.db
