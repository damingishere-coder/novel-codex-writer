# Local temporary files
tmp/

# Secrets and machine-specific environment files
**/.env
**/.env.*
!**/.env.example

# User-created novel library data
# The canonical library lives under Novel-Codex-Writer/小说项目. These root rules
# also fail closed if an old launcher recreates the retired duplicate directory.
小说项目/projects.json
小说项目/作品/*
!小说项目/作品/.gitkeep
小说项目/.trash/*
!小说项目/.trash/.gitkeep

# Dependencies, caches, and build output
**/node_modules/
**/dist/
**/__pycache__/
**/.sessions/
**/.runtime/
**/.scannerwork/
**/.e2e-library/
**/coverage/
**/playwright-report/
**/test-results/
.coverage
coverage-python.xml
**/npm-audit.json
*.py[cod]
*.log

# Operating-system metadata
.DS_Store
Thumbs.db
